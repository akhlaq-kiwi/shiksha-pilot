{
    "name": "bn-school/backend",
    "description": "Slim PHP backend for BN School SaaS Management Platform",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^6.4",
        "psr/http-message": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "process-timeout": 0,
        "allow-plugins": {
            "easy-dir/composer-plugin": true
        }
    }
}
