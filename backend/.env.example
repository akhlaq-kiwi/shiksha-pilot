APP_ENV=development
APP_DEBUG=true
APP_NAME="Shiksha Pilot"
DB_HOST=db
DB_PORT=3306
DB_NAME=shiksha_pilot
DB_USER=root
DB_PASS=your_password_here

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shikshapilot@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_NAME=ShikshaPilot

# Firebase Cloud Messaging (push notifications).
# Option 1 (Recommended): Set full JSON string or base64-encoded JSON in env variable:
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Option 2: Place downloaded Service Account JSON file at:
#   backend/config/firebase-service-account.json
# or specify FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_PATH=

# Option 3: Alternatively set discrete credentials below:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
