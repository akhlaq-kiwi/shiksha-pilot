<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode counterpart of values-v31/styles.xml. Parent stays
         Theme.Black to match the existing values-night convention; the splash
         itself keeps the brand indigo in both modes, since the mark's white
         details need a dark ground either way. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#3F51B5</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
