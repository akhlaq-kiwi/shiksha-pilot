# ShikshaPilot — sample environment file
#
# Copy to backend/.env and fill in real values. Never commit .env.
# The loader (App\Bootstrap\loadEnvFile) resolves the backend root, which is
# /var/www/html in the container — i.e. backend/.env on the host, not ./.env.
#
# Note: values already exported in the environment (e.g. the `environment:`
# blocks in docker-compose.yml) take precedence — .env never overrides them.

# ── App ───────────────────────────────────────────────────────────────────────
# Show Slim error details. Set to 0 in production.
APP_DEBUG=1

# ── Database (MySQL) ──────────────────────────────────────────────────────────
# Inside Docker the host is the compose service name `db`; from the host
# machine use 127.0.0.1 with the published port 2001.
DB_HOST=db
DB_PORT=3306
DB_NAME=shiksha_pilot
DB_USER=root
DB_PASS=admin123

# ── Push notifications (Firebase Cloud Messaging) ─────────────────────────────
# Pick ONE of the three options below. Resolution order in FcmClient:
#   1. inline JSON, 2. credentials file path, 3. discrete fields.
#
# 1) Full service-account JSON on one line (best for CI / hosting panels):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}
#
# 2) Path to the service-account file (default: backend/config/firebase-service-account.json):
# FIREBASE_CREDENTIALS_PATH=/var/www/html/config/firebase-service-account.json
#
# 3) Discrete fields. Keep the literal \n escapes in the private key.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# ── Outgoing email (SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shikshapilot@gmail.com
# Gmail app password — required for mail to actually send.
SMTP_PASS=
SMTP_FROM_NAME=ShikshaPilot

# ── Marketing website ─────────────────────────────────────────────────────────
# Google Tag Manager container. Leave blank to disable analytics.
GTM_CONTAINER_ID=

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# These belong in frontend/.env — Vite only exposes VITE_-prefixed vars, and
# they are baked into the client bundle, so never put secrets here.
# Inside Docker the API is http://backend:8000; from a browser use
# http://localhost:2002.
VITE_API_URL=http://localhost:2002
VITE_APP_NAME=ShikshaPilot
VITE_APP_VERSION=1.0.0


# AWS S3 Storage (Multi-project shared bucket support)
STORAGE_DRIVER=s3 # Options: 's3' or 'local'
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ROOT_FOLDER=sp
AWS_URL=https://sp-akh.s3.ap-south-1.amazonaws.com
