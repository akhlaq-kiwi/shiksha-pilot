# Copy to .env and adjust for your local environment.

# Base URL of the running frontend.
# Local dev server (npm run dev in frontend/): http://localhost:3000
# Docker compose stack:                        http://localhost:2003
BASE_URL=http://localhost:2003

# Set to "1" to have Playwright start `npm run dev` in frontend/ automatically
# before the test run (see playwright.config.js webServer block).
PW_START_WEB_SERVER=0

# Plaintext passwords for the seeded E2E accounts (data/login-credentials.csv
# maps role -> phone -> which of these env vars to use). Only bcrypt hashes
# are committed to the repo, so these must be supplied locally / via CI secrets.
# Rows in login-credentials.csv stay skip=1 until both the phone number and
# corresponding password below are filled in.
E2E_SUPER_ADMIN_PASSWORD=
E2E_SCHOOL_ADMIN_PASSWORD=
E2E_TEACHER_PASSWORD=
E2E_STUDENT_PASSWORD=
E2E_PARENT_PASSWORD=
