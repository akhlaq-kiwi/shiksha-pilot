# Shiksha Pilot website — Apache config for SEO-clean URLs, security and caching.

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS — skipped when the Host header carries an explicit port
  #    (i.e. local/Docker dev, http://localhost:2005), since that's never
  #    true for the real domain in production.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !:[0-9]+$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Force the canonical apex host (no www) — avoids duplicate-content
  #    URLs ranking against each other.
  RewriteCond %{HTTP_HOST} ^www\.shikshapilot\.com$ [NC]
  RewriteRule ^ https://shikshapilot.com%{REQUEST_URI} [L,R=301]

  # 3. Collapse trailing slashes (except the root) — /features/ -> /features
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # 4. If someone links directly to the .php file, redirect to the clean
  #    URL so there's exactly one indexable address per page.
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 5. sitemap.xml is generated by sitemap.php so it can't go stale
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # 5b. /schools-in-<slug> -> schools-in.php?slug=<slug> — one page handles
  #     both state slugs (schools-in-uttar-pradesh) and city/district slugs
  #     (schools-in-lucknow), see schools-in.php for how it tells them apart.
  RewriteRule ^schools-in-([a-z0-9-]+)$ schools-in.php?slug=$1 [L,QSA]

  # 6. Serve the clean URL from the matching .php file if it exists,
  #    without exposing the .php extension.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^([^/]+)$ $1.php [L]

  # 7. Anything else that doesn't resolve to a real file/directory -> 404 page
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /404.php [L]
</IfModule>

ErrorDocument 404 /404.php

# Never serve the includes/ partials directly — they assume they're
# being require()'d with variables already set, not requested standalone.
<IfModule mod_rewrite.c>
  RewriteRule ^includes/ - [F,L]
</IfModule>

<FilesMatch "\.(env|log|md)$">
  Require all denied
</FilesMatch>

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# ---------- Browser caching ----------
# ExpiresByType keys must match the MIME type Apache actually serves —
# .js comes through as text/javascript here (not application/javascript),
# so both are listed rather than assuming one.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType text/javascript         "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/png               "access plus 1 month"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|svg|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
