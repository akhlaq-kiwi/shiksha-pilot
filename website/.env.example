# Copy to .env for a local override, or let deploy-website.yml generate
# this automatically from GitHub Secrets during production deployment.
# Not needed for docker-compose local dev — those DB_* values are already
# passed in directly as container environment variables.
DB_HOST=db
DB_NAME=shiksha_pilot
DB_USER=root
DB_PASS=admin123

# Google Tag Manager container ID (looks like GTM-XXXXXXX). Leave blank
# locally — the site simply won't load the GTM script when this is empty.
# GA4 itself is configured as a tag inside the GTM container (via the Tag
# Manager UI), not here.
GTM_CONTAINER_ID=
