# Copy to .env for a local override, or let deploy-website.yml generate
# this automatically from GitHub Secrets during production deployment.
# Not needed for docker-compose local dev — those DB_* values are already
# passed in directly as container environment variables.
DB_HOST=db
DB_NAME=shiksha_pilot
DB_USER=root
DB_PASS=admin123

# GA4 Measurement ID (looks like G-XXXXXXXXXX). Leave blank locally — the
# site simply won't load the Google Analytics script when this is empty.
GA_MEASUREMENT_ID=
